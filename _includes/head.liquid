<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '930px' }};
  }
</style>

<!-- Tailwind-first core styles -->
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url | bust_file_cache }}">

{% if site.al_folio.compat.bootstrap.enabled %}
  <!-- Optional Bootstrap compatibility layer -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-compat.css' | relative_url | bust_file_cache }}">
{% endif %}

{% if page.pretty_table and site.al_folio.compat.bootstrap.enabled %}
  <!-- Bootstrap Table -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Tocbot -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.tocbot.url.css }}"
    integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Icons -->
{% if site.plugins contains 'al_icons' %}
  {% include plugins/al_icons_styles.liquid %}
{% endif %}
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
>

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if page.layout == 'cv' and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  <link rel="stylesheet" href="{{ '/assets/css/al-folio-cv.css' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.plugins contains 'al_img_tools' %}
  <!-- Image Features -->
  {% include plugins/al_img_tools_styles.liquid %}
{% endif %}

{% if site.plugins contains 'al_math' %}
  {% include plugins/al_math_styles.liquid %}
{% endif %}

{% if site.enable_cookie_consent and site.plugins contains 'al_cookie' %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_styles.liquid %}
{% endif %}

<!-- Site-local overrides -->
<style>
  /* CoRL 2026 · Compositionality for Robot Intelligence
     Sleek modern academic palette: cool off-white surfaces, off-black slate
     ink, single CoRL-orange accent. Overrides the gem's default theme tokens.
     Loaded before workshop.css; workshop.css owns the component layer. */
  :root {
    --global-theme-color: #e8590c;
    --global-hover-color: #f97316;
    --global-hover-text-color: #ffffff;
    --global-back-to-top-bg-color: #e8590c;
    --global-back-to-top-text-color: #ffffff;
    --global-distill-app-color: #e8590c;
  }

  /* Pill navbar: floats at the top, centered, matching page content width.
     Glass surface with a hairline accent edge along the bottom of the pill. */
  #navbar.navbar {
    left: 50% !important;
    right: auto !important;
    top: 0.75rem !important;
    width: min(calc(100% - 1.5rem), 1080px) !important;
    max-width: none !important;
    min-height: 0;
    padding: 0.3rem 0.45rem !important;
    background-color: rgba(252, 253, 254, 0.82) !important;
    opacity: 1 !important;
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04) !important;
    border: 1px solid rgba(15, 23, 42, 0.07) !important;
    border-radius: 999px !important;
    transform: translateX(-50%);
  }
  #navbar.navbar::before {
    display: none !important;
  }
  #navbar .container {
    max-width: none !important;
    padding: 0 !important;
    align-items: center;
    position: relative;
  }

  /* Hide the gem-rendered full site-title brand on subpages; the compact
     ws-brand lockup (injected below) is the single brand in the navbar. */
  #navbar .navbar-brand.title {
    display: none !important;
  }

  /* Compact brand lockup: a small accent square + short workshop title. */
  #navbar .navbar-brand.ws-brand {
    display: flex !important;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.7rem !important;
    margin: 0 !important;
    margin-right: 0.6rem !important;
    font-family: "IBM Plex Mono", "IBM Plex Sans", monospace;
    font-size: 0.78rem !important;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--global-text-color, #0b1220) !important;
    white-space: nowrap;
    border-radius: 999px;
    transition: color 160ms ease, background-color 160ms ease;
  }
  #navbar .navbar-brand.ws-brand::before {
    content: "";
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--global-theme-color);
    transform: rotate(45deg);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #navbar .navbar-brand.ws-brand:hover {
    color: var(--global-theme-color) !important;
    text-decoration: none;
    background: rgba(232, 89, 12, 0.06);
  }
  #navbar .navbar-brand.ws-brand:hover::before {
    transform: rotate(135deg);
  }

  /* Nav links: pill hover surface, no underline (pill navbar). */
  #navbar .nav-link {
    padding-top: 0.4rem !important;
    padding-bottom: 0.4rem !important;
    padding-left: 0.85rem !important;
    padding-right: 0.85rem !important;
    font-size: 0.88rem !important;
    color: var(--global-text-color-light, #5b6573) !important;
    border-radius: 999px !important;
    background: transparent !important;
    position: relative;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }
  #navbar .nav-link:hover,
  #navbar .nav-link:focus {
    color: var(--global-theme-color) !important;
    background: rgba(232, 89, 12, 0.07) !important;
  }
  #navbar .nav-link.active {
    color: #fff !important;
    background: var(--global-theme-color) !important;
    font-weight: 600;
  }
  #navbar .nav-link.active::after {
    display: none !important;
  }

  /* Right-align nav items within the text-width container. */
  #navbar .navbar-collapse-main {
    margin-left: auto !important;
    justify-content: flex-end !important;
  }
  #navbar .navbar-menu-list {
    margin-left: auto !important;
    gap: 0.35rem !important;
  }

  /* Offset body content for the floating pill navbar. */
  body.fixed-top-nav {
    padding-top: 4.75rem;
  }

  /* Breathing room between fixed navbar and page content site-wide. */
  body > .container,
  body > main > .container,
  main > .container,
  .post-header {
    padding-top: 1.25rem;
  }
  .post-header {
    margin-top: 0.5rem;
  }

  /* Extra vertical space above section titles site-wide. */
  .post > article h2,
  .post > article h3,
  .post > article h4,
  article h2,
  article h3,
  article h4 {
    margin-top: 3rem;
  }
  .post > article > h2:first-child,
  .post > article > h3:first-child,
  .post > article > h4:first-child,
  article > h2:first-child,
  article > h3:first-child,
  article > h4:first-child {
    margin-top: 1.5rem;
  }
</style>
<link rel="stylesheet" href="{{ '/assets/css/workshop.css' | relative_url | bust_file_cache }}">

<!-- Inject a compact brand lockup into the gem-owned navbar. -->
<script>
  (function () {
    function addBrand() {
      var nav = document.getElementById('navbar');
      if (!nav) return;
      var container = nav.querySelector('.container');
      if (!container || container.querySelector('.navbar-brand.ws-brand')) return;
      var a = document.createElement('a');
      a.className = 'navbar-brand ws-brand';
      a.href = '{{ "/" | relative_url }}';
      a.setAttribute('aria-label', 'Compositionality for Robot Intelligence — home');
      a.textContent = 'CoRL 2026 · Compositionality';
      container.insertBefore(a, container.firstChild);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', addBrand);
    } else {
      addBrand();
    }
  })();
</script>
